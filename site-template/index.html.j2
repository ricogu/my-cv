<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">

  <title>{{ personal.name }} - {{ about.headline }}</title>
  <meta content="Personal site of {{ personal.name }} ({{ personal.full_name }}) - {{ about.headline }}. Kubernetes, Gardener, IronCore, Cluster API, GitOps, platform reliability, software tooling, and AI-assisted engineering workflows." name="description">
  <meta content="Platform Engineer, DevOps Engineer, Cloud Native, Kubernetes, Gardener, IronCore, Cluster API, GitOps, SRE, Software Tooling, AI-assisted engineering" name="keywords">
  <link rel="canonical" href="https://ricogu.github.io/my-cv/">

  <!-- Favicons -->
  <link href="assets/img/favicon.png" rel="icon">
  <link href="assets/img/apple-touch-icon.png" rel="apple-touch-icon">

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Raleway:300,300i,400,400i,500,500i,600,600i,700,700i|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i" rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="assets/vendor/aos/aos.css" rel="stylesheet">
  <link href="assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="assets/vendor/boxicons/css/boxicons.min.css" rel="stylesheet">
  <link href="assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
  <link href="assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

  <!-- Template Main CSS File -->
  <link href="assets/css/style.css" rel="stylesheet">

</head>

<body>

<!-- ======= Mobile nav toggle button ======= -->
<i class="bi bi-list mobile-nav-toggle d-lg-none"></i>

<!-- ======= Header ======= -->
<header id="header" class="d-flex flex-column justify-content-center">

  <nav id="navbar" class="navbar nav-menu">
    <ul>
      <li><a href="#hero" class="nav-link scrollto active"><i class="bx bx-home"></i> <span>Home</span></a></li>
      <li><a href="#about" class="nav-link scrollto"><i class="bx bx-user"></i> <span>About</span></a></li>
      <li><a href="#resume" class="nav-link scrollto"><i class="bx bx-file-blank"></i> <span>Resume</span></a></li>
      <li><a href="#contact" class="nav-link scrollto"><i class="bx bx-envelope"></i> <span>Contact</span></a></li>
    </ul>
  </nav><!-- .nav-menu -->

</header><!-- End Header -->

<!-- ======= Hero Section ======= -->
<section id="hero" class="d-flex flex-column justify-content-center">
  <div class="container" data-aos="zoom-in" data-aos-delay="100">
    <h1>{{ personal.name }}</h1>
    <p>I'm <span class="typed" data-typed-items="{{ personal.typed_items }}"></span></p>
    <div class="social-links">
      {% if personal.facebook %}<a href="{{ personal.facebook }}" class="facebook"><i class="bx bxl-facebook"></i></a>{% endif %}
      {% if personal.linkedin %}<a href="{{ personal.linkedin }}" class="linkedin"><i class="bx bxl-linkedin"></i></a>{% endif %}
      {% if personal.github %}<a href="{{ personal.github }}" class="github"><i class="bx bxl-github"></i></a>{% endif %}
    </div>
  </div>
</section><!-- End Hero -->

<main id="main">

  <!-- ======= About Section ======= -->
  <section id="about" class="about">
    <div class="container">
      <div class="section-title">
        <h2>About</h2>
      </div>
      <div class="row">
        <div class="col-lg-4" data-aos="fade-right">
          <img src="assets/img/profile.jpg" class="img-fluid" alt="{{ personal.name }} profile portrait">
        </div>
        <div class="col-lg-8 pt-4 pt-lg-0 content" data-aos="fade-left">
          <h3>{{ about.headline }}</h3>
          <p class="fst-italic">
            {{ about.summary }}
          </p>
          <div class="mt-4">
            <a class="btn btn-primary btn-lg" href="rico-cv.pdf" target="_blank"><i class="bx bxs-download"></i> Download My CV</a>
          </div>
          <div class="mt-3">
            <p>Reference letters are available upon request.</p>
          </div>
        </div>
      </div>
    </div>
  </section><!-- End About Section -->

  <!-- ======= Resume Section ======= -->
  <section id="resume" class="resume">
    <div class="container">

      <div class="section-title">
        <h2>Resume</h2>
        <p>Here is a summary of my professional background and achievements.</p>
      </div>

      {% if core_competencies %}
      <div class="row">
        <div class="col-lg-12">
          <h3 class="resume-title">Core Competencies</h3>
          <div class="resume-item">
            <ul>
              {% for comp in core_competencies %}
              <li><strong>{{ comp.category }}:</strong> {{ comp.skills | join(', ') }}</li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
      {% endif %}

      <div class="row">
        <div class="col-lg-6">
          <h3 class="resume-title">Professional Experience</h3>
          {% for job in experience %}
          <div class="resume-item">
            <h4>{{ job.title }}</h4>
            <h5>{{ job.company }}</h5>
            <p><em>{{ job.period }}</em></p>
            <ul>
              {% for bullet in job.bullets %}
              <li>{{ bullet }}</li>
              {% endfor %}
            </ul>
          </div>
          {% endfor %}
        </div>
        <div class="col-lg-6">
          <h3 class="resume-title">Education</h3>
          {% for edu in education %}
          <div class="resume-item">
            <h4>{{ edu.degree }}</h4>
            <h5>{{ edu.school }}</h5>
            <p><em>{{ edu.period }}</em></p>
            <ul>
              {% for bullet in edu.bullets %}
              <li>{{ bullet }}</li>
              {% endfor %}
            </ul>
          </div>
          {% endfor %}

          {% if publications %}
          <h3 class="resume-title">Selected Publications</h3>
          <div class="resume-item">
            <ul>
              {% for pub in publications %}
              <li>{{ pub }}</li>
              {% endfor %}
            </ul>
          </div>
          {% endif %}

          {% if interests %}
          <h3 class="resume-title">Interests</h3>
          <div class="resume-item">
            <p>{{ interests | join(' · ') }}</p>
          </div>
          {% endif %}

        </div>
      </div>

    </div>
  </section><!-- End Resume Section -->

  <!-- ======= Contact Section ======= -->
  <section id="contact" class="contact">
    <div class="container">

      <div class="section-title">
        <h2>Contact</h2>
      </div>

      <div class="row g-4 justify-content-center" data-aos="fade-in">

        <div class="col-lg-8 d-flex align-items-stretch">
          <div class="contact-cta">
            <h4>Get in touch</h4>
            <p>Prefer async? These are the fastest ways to reach me.</p>
            <div class="cta-buttons">
              <a class="btn btn-primary btn-lg" href="mailto:{{ personal.email }}"><i class="bx bx-envelope"></i> Email me</a>
              {% if personal.linkedin %}<a class="btn btn-outline-primary btn-lg" href="{{ personal.linkedin }}" target="_blank" rel="noopener"><i class="bx bxl-linkedin"></i> LinkedIn</a>{% endif %}
              {% if personal.github %}<a class="btn btn-outline-primary btn-lg" href="{{ personal.github }}" target="_blank" rel="noopener"><i class="bx bxl-github"></i> GitHub</a>{% endif %}
            </div>
          </div>
        </div>

      </div>

    </div>
  </section><!-- End Contact Section -->

</main><!-- End #main -->

<!-- ======= Footer ======= -->
<footer id="footer">
  <div class="container">
    <div class="credits">
      &copy; {{ personal.name }}
    </div>
  </div>
</footer><!-- End Footer -->

<div id="preloader"></div>
<a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

<!-- Vendor JS Files -->
<script src="assets/vendor/purecounter/purecounter_vanilla.js"></script>
<script src="assets/vendor/aos/aos.js"></script>
<script src="assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="assets/vendor/glightbox/js/glightbox.min.js"></script>
<script src="assets/vendor/isotope-layout/isotope.pkgd.min.js"></script>
<script src="assets/vendor/swiper/swiper-bundle.min.js"></script>
<script src="assets/vendor/typed.js/typed.umd.js"></script>
<script src="assets/vendor/waypoints/noframework.waypoints.js"></script>
<script src="assets/vendor/php-email-form/validate.js"></script>

<!-- Template Main JS File -->
<script src="assets/js/main.js"></script>

</body>

</html>
